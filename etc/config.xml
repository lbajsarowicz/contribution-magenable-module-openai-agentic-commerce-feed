<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Store:etc/config.xsd">
    <default>
        <magenable_openai_agentic_commerce_feed>
            <general>
                <enabled>0</enabled>
                <cron_schedule>0 0 * * *</cron_schedule>
                <file_format>xml</file_format>
                <last_generation_date></last_generation_date>
                <attributes_mapping>
                    <item1>
                        <feed_attribute>enable_search</feed_attribute>
                        <website_attribute>status</website_attribute>
                        <custom_value></custom_value>
                    </item1>
                    <item2>
                        <feed_attribute>enable_checkout</feed_attribute>
                        <website_attribute>status</website_attribute>
                        <custom_value></custom_value>
                    </item2>
                    <item3>
                        <feed_attribute>id</feed_attribute>
                        <website_attribute>sku</website_attribute>
                        <custom_value></custom_value>
                    </item3>
                    <item4>
                        <feed_attribute>title</feed_attribute>
                        <website_attribute>name</website_attribute>
                        <custom_value></custom_value>
                    </item4>
                    <item5>
                        <feed_attribute>description</feed_attribute>
                        <website_attribute>description</website_attribute>
                        <custom_value></custom_value>
                    </item5>
                    <item6>
                        <feed_attribute>link</feed_attribute>
                        <website_attribute>url_key</website_attribute>
                        <custom_value></custom_value>
                    </item6>
                    <item7>
                        <feed_attribute>image_link</feed_attribute>
                        <website_attribute>image</website_attribute>
                        <custom_value></custom_value>
                    </item7>
                    <item8>
                        <feed_attribute>price</feed_attribute>
                        <website_attribute>price</website_attribute>
                        <custom_value></custom_value>
                    </item8>
                    <item9>
                        <feed_attribute>availability</feed_attribute>
                        <website_attribute>quantity_and_stock_status</website_attribute>
                        <custom_value></custom_value>
                    </item9>
                    <item10>
                        <feed_attribute>inventory_quantity</feed_attribute>
                        <website_attribute>quantity_and_stock_status</website_attribute>
                        <custom_value></custom_value>
                    </item10>
                </attributes_mapping>
            </general>
        </magenable_openai_agentic_commerce_feed>
    </default>
</config>
