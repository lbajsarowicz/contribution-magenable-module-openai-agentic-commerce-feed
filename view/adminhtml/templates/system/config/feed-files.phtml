<?php
/** @var \Magenable\OpenAIAgenticCommerceFeed\Block\Adminhtml\System\Config\FeedFiles $block */
/** @var \Magento\Framework\Escaper $escaper */
/** @var \Magenable\OpenAIAgenticCommerceFeed\ViewModel\FeedFiles $viewModel */
$viewModel = $block->getViewModel();
if (!$files = $viewModel->getFiles()) {
    return;
}
?>
<div id="<?= $block->getHtmlId() ?>">
    <h5><?= $escaper->escapeHtml(__('List of all generated Feed Files:')) ?></h5>
    <ul style="margin-left: 20px">
        <?php foreach ($files as $file): ?>
        <li style="margin-bottom: 5px">
            <a href="<?= $escaper->escapeHtmlAttr($file['url']) ?>" target="_blank">
                <?= $escaper->escapeHtml($file['name']) ?>
            </a></li>
        <?php endforeach; ?>
    </ul>
</div>
